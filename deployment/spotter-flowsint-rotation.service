[Unit]
Description=SPOTTER Flowsint JWT token rotation
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/user/SPOTTER
# Renews the self-signed token (AUTH_SECRET + FLOWSINT_ADMIN_EMAIL from the
# encrypted tier) when fewer than 7 days remain; with the 365-day default this
# fires about once a year. Password login is only the fallback.
EnvironmentFile=-/etc/spotter/flowsint-admin.env
ExecStart=/usr/bin/python3 scripts/rotate_flowsint_token.py --renew-days 7
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
