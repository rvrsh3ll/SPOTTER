# ── SPOTTER environment variables ─────────────────────────────────────────────
# Copy to .env and fill in the REPLACE_WITH_* values that are CONFIGURATION
# (hosts, ports, paths, limits, feature flags).
#
# CREDENTIALS DO NOT GO IN .env. Every key below marked "-> secrets/<tier>" is a
# password or an API key and belongs in an encrypted tier, not in this file.
# deployment/setup-secrets.sh generates the machine-local ones and encrypts them
# for you; the rest you add with:
#
#     scripts/spotter_secret.py set FLARE_API_KEY      # prompts, never echoes
#     scripts/spotter_secret.py list                   # what is set, no values
#     scripts/spotter_secret.py audit                  # find leaks in .env
#
# A credential left in .env as plaintext is a hard failure: it blocks
# `scripts/spotter_compose.sh up` and fails check_workflow_regressions.py.
# Rationale and limits: README.md -> "Generate secrets".
# This file still lists every variable, including the credentials, because it is
# the reference for what exists and what each one does. But on a configured host
# the ~25 credentials live ENCRYPTED in secrets/*.sops.env (SOPS + age) and .env
# carries a pointer comment where the value used to be. setup-secrets.sh writes
# generated secrets straight into the machine tier.
#
#   scripts/split_env_to_sops.py --dry-run   what would move, and to which tier
#   sops secrets/vendors.sops.env            edit a local tier (never decrypt in place)
#   scripts/spotter_env.py KEY               is a key resolvable? (prints no values)
#
# Rationale and limits: README.md -> "Generate secrets".
#
# All services (Flowsint, n8n, the LLM backend, and Open WebUI) read from this file.

# ── Host layout ───────────────────────────────────────────────────────────────
# The two absolute paths every other path in the stack derives from.
# setup-secrets.sh writes both; scripts/spotter_compose.sh derives SPOTTER_HOME
# from its own location and exports it, so a launch through the launcher is right
# even if this file is wrong. Set them by hand only if you relocate a checkout.
#
# They exist because this stack is a multi-file compose invocation whose FIRST -f
# belongs to the Flowsint repo, and compose resolves relative paths against the
# PROJECT directory — that other checkout, not this one. Every "../scripts"-style
# default therefore landed one directory too high, silently, on whatever happened
# to be there: an empty dir over the enrichers for three weeks, and later a stale
# n8n-task-runners.json enforcing an older import allowlist. Both must be
# ABSOLUTE; a relative value brings that whole class of failure back.
#
# SPOTTER_HOME  — this checkout.
# FLOWSINT_HOME — the Flowsint checkout. SPOTTER does not define the data tier:
#                 Neo4j, Postgres, Redis, flowsint-api and the Flowsint UI all
#                 live there, and its compose file is the FIRST -f of every
#                 launch. scripts/bootstrap.sh clones it to vendor/ inside this
#                 checkout, at the commit pinned in deployment/flowsint.lock, so
#                 the whole stack is one copyable directory. An existing sibling
#                 checkout still works — just name it here.
#
#                 Note this is also compose's PROJECT DIRECTORY, which is why a
#                 relative *_DIR above resolves there rather than here.
SPOTTER_HOME=/absolute/path/to/SPOTTER
FLOWSINT_HOME=/absolute/path/to/SPOTTER/vendor/flowsint

# ── Persistent-state layout ───────────────────────────────────────────────────
# Where the databases keep their files. Two supported layouts, and the choice is
# made ONCE per host by deployment/setup-secrets.sh — you should not normally
# edit these by hand.
#
#   UNSET (leave them commented out)
#       Each mount is the named Docker volume it has always been, under
#       /var/lib/docker. This is what every host installed before the folder
#       layout runs, and it stays supported. A copy of the SPOTTER directory is
#       then NOT a complete backup — use deployment/migrate-backup.sh.
#
#   SET to absolute paths under SPOTTER_HOME
#       Each mount is a bind inside the checkout, so a cold copy of this one
#       directory really is the whole system. setup-secrets.sh picks this for a
#       fresh install and creates each directory with the uid its image needs
#       (neo4j 7474, postgres 70, redis 999, n8n 1000 — n8n's container never
#       runs as root, so that one cannot fix its own ownership).
#
# setup-secrets.sh will NOT set these on a host whose named volumes already
# exist. Repointing a live Neo4j at an empty directory does not error: Docker
# creates the directory, the database initialises into it, and the operator sees
# an empty campaign list. If you are migrating deliberately, move the data first
# (deployment/migrate-backup.sh, then migrate-restore.sh).
#
# A relative value is the dangerous typo. `./data/neo4j` resolves against
# vendor/flowsint, not here, and Docker creates it rather than erroring.
# scripts/spotter_compose.sh refuses to launch on one, and also on an absolute
# path whose directory does not already exist.
#
# SPOTTER_REDIS_DATA carries "<host path>:/data" — the target as well as the
# source — because upstream gives redis no volumes: key for us to override.
# SPOTTER_NEO4J_DATA=/absolute/path/to/SPOTTER/data/neo4j/data
# SPOTTER_NEO4J_LOGS=/absolute/path/to/SPOTTER/data/neo4j/logs
# SPOTTER_NEO4J_IMPORT=/absolute/path/to/SPOTTER/data/neo4j/import
# SPOTTER_NEO4J_PLUGINS=/absolute/path/to/SPOTTER/data/neo4j/plugins
# SPOTTER_PG_DATA=/absolute/path/to/SPOTTER/data/postgres
# SPOTTER_REDIS_DATA=/absolute/path/to/SPOTTER/data/redis:/data
# SPOTTER_N8N_DATA=/absolute/path/to/SPOTTER/data/n8n
# SPOTTER_OPEN_WEBUI_DATA=/absolute/path/to/SPOTTER/data/open-webui
# SPOTTER_TOR_DATA=/absolute/path/to/SPOTTER/data/tor
# SPOTTER_CADDY_DATA_DIR=/absolute/path/to/SPOTTER/data/caddy
#
# The vLLM model cache is deliberately NOT in this list: ~32 GB of
# re-downloadable weights stays a named volume so the portable folder stays
# small. deployment/migrate-backup.sh --include-models archives it on demand.

# ── Flowsint internal secrets ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set AUTH_SECRET)
AUTH_SECRET=REPLACE_WITH_GENERATED_HEX

# Generate: python3 -c "import os, base64; print('base64:' + base64.b64encode(os.urandom(32)).decode())"
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set MASTER_VAULT_KEY_V1)
MASTER_VAULT_KEY_V1=REPLACE_WITH_GENERATED_B64

# Neo4j password, shared between Flowsint and SPOTTER's direct Cypher queries.
#
# INIT-ONLY. Flowsint's compose passes this as NEO4J_AUTH, which the neo4j image
# honours only while initialising an EMPTY data volume. Editing it afterwards does
# not change the database password — it changes what every client sends, so they
# all start failing against the password the volume already has.
#
# That failure is loud in the infrastructure and silent where an operator looks:
# neo4j's healthcheck fails forever, so flowsint-api and flowsint-celery never
# start (they gate on service_healthy) — but the first symptom on screen is
# usually "my campaigns disappeared", because the campaign registry read swallows
# the auth error and returns an empty list.
#
# Note it is interpolated as NEO4J_USERNAME (not NEO4J_USER) by Flowsint's compose
# file. Set both keys below; they must agree.
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set NEO4J_PASSWORD)
NEO4J_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j

# ── Flowsint API ──────────────────────────────────────────────────────────────
# Internal Docker service URL (n8n/Open WebUI reach flowsint-api on this)
FLOWSINT_API_URL=http://flowsint-api:5001

# Bearer token generated in Flowsint UI → Settings → API Keys
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set FLOWSINT_API_KEY)
FLOWSINT_API_KEY=REPLACE_WITH_FLOWSINT_API_TOKEN

# Per-campaign isolation: each SPOTTER campaign now provisions its OWN Flowsint
# sketch (via the create-sketch webhook / WF16), and the frontend sends that
# campaign's sketch_id on every webhook call so data never mixes between campaigns.
# This value is only a FALLBACK/default sketch used when a request carries no
# sketch_id (e.g. scheduled workflows WF01/WF14, or a legacy client). Point it at a
# throwaway "default" sketch; it is NOT where campaign data should land.
FLOWSINT_SKETCH_ID=REPLACE_WITH_FLOWSINT_SKETCH_UUID

# ── Neo4j (for direct Cypher queries in LLM graph tool) ───────────────────────
NEO4J_HTTP_URL=http://flowsint-neo4j-prod:7474

# ── Flowsint Postgres ────────────────────────────────────────────────────────
# Read by Flowsint's own compose file, which this stack includes as its first -f.
# Upstream defaults every one of these to the literal string "flowsint", so an
# install that never sets them runs its database on a published-default password.
# It is bound to 127.0.0.1:5433, not the network, but set a real one anyway.
#
# INIT-ONLY, like NEO4J_PASSWORD below it. Postgres applies POSTGRES_PASSWORD when
# it initialises an EMPTY data volume and never again. Setting it here after the
# first `up` changes nothing: the old password keeps working, the new one does
# not, and nothing warns you. To change it on a live install you must
# `ALTER ROLE <user> WITH PASSWORD '<new>';` inside the container and then
# recreate postgres, api and celery together.
POSTGRES_USER=flowsint
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set POSTGRES_PASSWORD)
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=flowsint

# Image tag for the Flowsint api/celery images. Defaults to `latest`, which means
# a rebuild can silently move you to a different upstream version; pin it for a
# reproducible install (a classroom especially).
FLOWSINT_VERSION=latest


# ── Docker network ────────────────────────────────────────────────────────────
# Must match the network created by Flowsint's docker-compose project.
# Default when using the Flowsint prod stack: flowsint_network_prod
FLOWSINT_NETWORK=flowsint_network_prod

# ── Caddy TLS front door (deployment/docker-compose.caddy.yml) ───────────────
# The one HTTPS port everything is reached through. spotter-ui (nginx) no
# longer publishes 8080/8081/8082/8099 to the host; Caddy re-terminates TLS in
# front of each, using its own built-in internal CA (there is no public DNS
# here to get a real cert for). Dashboard / n8n editor / Flowsint app are
# distinguished by HOSTNAME on this one port, not by path — see
# deployment/Caddyfile for why. Defaults are *.localhost names, which every
# modern browser/OS resolves to 127.0.0.1 on its own (RFC 6761) -- no
# /etc/hosts entry needed. Only add one if you changed these to something
# else, or your client's resolver is too old to handle multi-label .localhost.
# First visit to each warns until Caddy's root CA is trusted:
#   docker exec spotter-caddy cat /data/caddy/pki/authorities/local/root.crt
SPOTTER_CADDY_PORT=5443
SPOTTER_DASHBOARD_HOST=spotter.localhost
SPOTTER_N8N_HOST=n8n.spotter.localhost
SPOTTER_GRAPH_HOST=graph.spotter.localhost
# Open WebUI. Its container port is still published on 127.0.0.1:3000 for
# host-side tooling (scripts/setup_openwebui.py), but a browser reaching SPOTTER
# through the forwarded 5443 has no route to that port -- this vhost is how the
# dashboard's Chat link and the Prompt tab's ENDPOINT get there.
SPOTTER_CHAT_HOST=chat.spotter.localhost

# ── Cobalt Strike Team Server ─────────────────────────────────────────────────
# REST API endpoint on the CS Team Server (default port 50050)
CS_API_URL=https://your-cs-teamserver:50050

# CS REST API token (generate in Cobalt Strike: Tools → REST API → Generate Token)
#   ^^ CREDENTIAL -> secrets/engagement.sops.env  (do NOT put the value here; scripts/spotter_secret.py set CS_API_TOKEN)
CS_API_TOKEN=REPLACE_WITH_CS_REST_API_TOKEN

# ── Adaptix C2 teamserver (workflow 28) ──────────────────────────────────────
# Workflow 28 polls the Adaptix teamserver Web API every 5 minutes and ingests its
# agent roster as C2Session nodes, exactly as workflow 01 does for Cobalt Strike.
# Left as placeholders the poll no-ops: the fetch node treats a REPLACE_WITH_*
# value as "not configured" and never attempts a connection.
#
# THE URL MUST INCLUDE THE ENDPOINT PREFIX. Adaptix's profile.json sets a URI
# prefix that every API route hangs off -- commonly "/endpoint", but it is
# operator-chosen per teamserver. A bare scheme://host:port reaches nothing.
#
#   ADAPTIX_API_URL=https://10.0.0.5:4321/endpoint
#
# Reaching the teamserver is OUTBOUND, the opposite of the Brute Ratel receiver
# below: either the teamserver is routable from this host, or you hold a forward
#
#   ssh -N -L 4321:127.0.0.1:4321 <teamserver>
#
# and point ADAPTIX_API_URL at https://127.0.0.1:4321/endpoint. Nothing in the
# workflow changes between the two -- it is purely what this URL says.
#
# Adaptix issues NO static API token. The poll authenticates with an operator
# account (POST /login → a short-lived access_token) on every run, so these are
# real teamserver credentials: scope the account to what the poll needs.
#
# A REJECTED LOGIN ANSWERS HTTP 404, not 401 -- the teamserver serves its 404 page
# for unauthenticated requests, so bad credentials and a wrong URL look identical.
# Workflow 28 says which it thinks it hit; believe the credentials first.
ADAPTIX_API_URL=REPLACE_WITH_ADAPTIX_API_URL
#   ^^ CREDENTIAL -> secrets/engagement.sops.env  (do NOT put the value here; scripts/spotter_secret.py set ADAPTIX_USERNAME)
ADAPTIX_USERNAME=REPLACE_WITH_ADAPTIX_USERNAME
#   ^^ CREDENTIAL -> secrets/engagement.sops.env  (do NOT put the value here; scripts/spotter_secret.py set ADAPTIX_PASSWORD)
ADAPTIX_PASSWORD=REPLACE_WITH_ADAPTIX_PASSWORD

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_USER=admin
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set N8N_PASSWORD)
N8N_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Credential-encryption key. Set once to a 32+ char random value (e.g.
# `openssl rand -hex 24`) and never change it, or n8n can't decrypt stored
# credentials. If you already ran n8n without this, copy the value from
# /home/node/.n8n/config (encryptionKey) inside the volume so nothing breaks.
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set N8N_ENCRYPTION_KEY)
N8N_ENCRYPTION_KEY=REPLACE_WITH_32CHAR_RANDOM

# Public base URL for n8n (used by workflows that call sibling webhooks)
N8N_WEBHOOK_BASE=http://localhost:5678

# ── Open WebUI ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set WEBUI_SECRET_KEY)
WEBUI_SECRET_KEY=REPLACE_WITH_GENERATED_HEX
# The Open WebUI admin account, RECORDED here rather than configured here. No
# container receives these (the open-webui service in docker-compose.llm.yml
# passes neither), and Open WebUI has no env var that provisions or resets an
# account — the credential is a bcrypt row in webui.db. Their only consumer is
# scripts/setup_openwebui.py, which signs in with them. So editing either value
# applies nothing and no restart propagates it: change the account first, via
# POST /api/v1/users/<id>/update for the email (writes both the `user` and
# `auth` tables — SQL that touches only one locks you out) or
# POST /api/v1/auths/update/password for the password, then match this file.
# On first install, the account is created by the signup form on first visit.
# Not to be confused with the SPOTTER portal login (deployment/auth-data/auth.db,
# `scripts/spotter_user.py`), or with the dashboard Prompt tab, which has no
# credential of its own — LLM CONFIG -> Connect mints a JWT from these values.
OWUI_ADMIN_EMAIL=REPLACE_WITH_OWUI_ADMIN_EMAIL
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set OWUI_ADMIN_PASSWORD)
OWUI_ADMIN_PASSWORD=REPLACE_WITH_OWUI_ADMIN_PASSWORD

# ── LLM tier ─────────────────────────────────────────────────────────────────
# Which model backend is part of the stack. scripts/spotter_compose.sh reads this
# and selects compose profiles accordingly, so it decides whether the `vllm`
# service exists at all -- which is what lets SPOTTER run on a host with no GPU.
#
#   local-large  The original: Qwen3.8-27B-FP8, validated on an RTX 6000 Ada
#                (48 GB VRAM). ~30-32 GB of weights plus the KV cache. VLLM_MAX_MODEL_LEN
#                49152 is the largest window that needs no extra memory at
#                VLLM_GPU_MEMORY_UTILIZATION 0.90.
#
#   local-small  No smaller model is selected automatically. Choose a model and
#                GPU that fit your workload. Set VLLM_MODEL and VLLM_MAX_MODEL_LEN
#                together -- the window may not exceed what
#                the KV cache can hold or the engine refuses to start, and the
#                27B's 49152 is NOT a safe number on a smaller card. Read the
#                actual figure from the "GPU KV cache size" line in
#                `docker logs spotter-vllm` after the first start, and never
#                assume the served window matches what you asked for:
#                  curl -s -H "Authorization: Bearer $VLLM_API_KEY" \
#                    http://127.0.0.1:8000/v1/models | jq '.data[] | {id, max_model_len}'
#
#   remote       No local model server. Point VLLM_URL at an endpoint someone else
#                runs (an instructor's host, say) and set VLLM_API_KEY to match.
#                Everything downstream already speaks the OpenAI API, so nothing
#                else changes. This is the classroom default when students have
#                no GPU.
#
#   none         No model anywhere. The stack still ingests, correlates and serves
#                the graph; the analysis workflows and the Prompt tab are the only
#                things that stop working.
SPOTTER_LLM_TIER=local-large

# ── vLLM runtime ─────────────────────────────────────────────────────────────
# vLLM exposes an OpenAI-compatible API. Keep the model ID identical to the
# Hugging Face model served by vLLM; it is not an Ollama model tag.
# For SPOTTER_LLM_TIER=remote, VLLM_URL is the only one of these that matters
# (plus VLLM_API_KEY); the GPU tuning below applies to the local tiers only.
VLLM_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
# Used by vLLM and sent by OpenAI-compatible clients. Keep this local-only
# value unless the API is intentionally exposed beyond the Docker network.
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set VLLM_API_KEY)
VLLM_API_KEY=REPLACE_WITH_LOCAL_VLLM_API_KEY
VLLM_IMAGE=vllm/vllm-openai:v0.17.0
# Which GPU(s) the model server may use, as NVIDIA_VISIBLE_DEVICES. "0" is the
# first card; "0,1" would expose two -- but see the tensor-parallel note below
# before assuming a second card helps.
VLLM_GPUS=0
VLLM_GPU_MEMORY_UTILIZATION=0.90
# 1, not 2: TP>1 deadlocks in NCCL init on these Ada cards and the model fits on
# one 49 GB card. This said 2 until 2026-09-08 while the live stack ran 1.
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=49152
# Not 256 — that value can never be served (real concurrency ~3.85x) and it
# breaks CUDA-graph capture on this hybrid model. See docker-compose.llm.yml.
VLLM_MAX_NUM_SEQS=16
# MTP speculative decoding draft tokens. Measured 2.10x single-stream at 1.
# Do not set 2: it hard-crashes the engine with an illegal memory access.
VLLM_SPEC_TOKENS=1
# Compatibility URL for unchanged WF10/WF12 request shapes. The local gateway
# translates these requests to vLLM.
OLLAMA_URL=http://llm-gateway:8080
# Single-service mode keeps the existing deterministic TF-IDF fallback. A
# separate embedding endpoint/model is required for semantic embeddings.
VLLM_EMBEDDING_MODE=tfidf
# Only used when VLLM_EMBEDDING_MODE=remote. The endpoint must implement
# OpenAI-compatible POST /v1/embeddings and return data[*].embedding. The URL
# must end in /v1 -- the client appends /embeddings.
#
# EMBEDDING_MODEL is the name the CLIENT sends. VLLM_EMBED_MODEL is the model the
# vllm-embed SERVER loads. They were one variable until 2026-09-06, so setting it
# fixed the client and repointed the server in the same edit; keep them equal.
# nomic-embed-text was the old hint here and is an Ollama tag -- vLLM cannot load
# it, and Ollama was removed from the stack on 2026-09-04.
# EMBEDDING_URL=http://vllm-embed:8000/v1
# EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
# VLLM_EMBED_MODEL=Alibaba-NLP/gte-modernbert-base
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set EMBEDDING_API_KEY)
# EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY

# ── SharpHound drop directory ─────────────────────────────────────────────────
# Host path. Drop SharpHound ZIPs here; workflow 02 watches inside the container.
#
# Use an ABSOLUTE path. A relative one resolves against each container's compose
# project directory, so if n8n and task-runners are ever brought up by different
# compose invocations they bind DIFFERENT host directories to the same container
# path. Python code nodes execute in the runner, so only the runner's directory
# is the one workflow 02 can actually read — a ZIP dropped in the other one is
# silently invisible and the sweep just reports success over an empty folder.
SHARPHOUND_DROP_DIR=/absolute/path/to/sharphound-drops
# Max DECODED size of a one-shot JSON upload (files of 32 MB or less). Caps that
# JSON body only. Do not raise N8N_PAYLOAD_SIZE_MAX to fit a larger file — the
# body is stored in n8n's execution SQLite. Default if unset: 32 MiB.
SPOTTER_UPLOAD_MAX_BYTES=94371840
# Browser files larger than 32 MB are chunked into ingest-staging/. This is the
# per-file cap. Above it the browser refuses and names the host ingest script.
SPOTTER_STAGED_UPLOAD_MAX_BYTES=4294967296
# Total bytes ingest-staging/ may hold. A create is refused when the declared
# size would exceed this, or when the disk cannot hold it.
SPOTTER_STAGED_UPLOAD_DISK_CAP=21474836480
# Largest staged file a workflow will read and parse. Above this the file stays
# on disk and the ack names the host command. Do not raise this unless the host
# can spare the RAM: the parser reads the file into the runner.
SPOTTER_RUNNER_PARSE_MAX_BYTES=1073741824
# Host path for chunked uploads. Leave unset to use $SPOTTER_HOME/ingest-staging.
# If you set it, it must be ABSOLUTE, and writable by uid 1000. This is not the
# SharpHound drop folder.
# SPOTTER_INGEST_STAGING_DIR=/absolute/path/to/SPOTTER/ingest-staging

# ── SPOTTER scripts directory (mounted into the n8n runners) ──────────────────
# Absolute host path to SPOTTER/scripts. The compose default now derives from
# SPOTTER_HOME, so leaving this unset is fine; set it only to point the runners at
# a different tree. It used to default to a bare "../scripts", which resolved
# correctly ONLY for a single-file invocation. If you do set it, keep it ABSOLUTE,
# and remember a backed-up .env from another machine carries that machine's path.
SPOTTER_SCRIPTS_DIR=/absolute/path/to/SPOTTER/scripts

# ── SPOTTER custom enrichers (mounted into flowsint-api and flowsint-celery) ──
# Absolute host path to SPOTTER/flowsint-custom/enrichers. Same rule and the same
# failure as SPOTTER_SCRIPTS_DIR, and this one is silent: a wrong path mounts an
# empty directory over the enrichers, Flowsint starts cleanly, and the enricher
# registry simply comes up short (50 instead of 59) with nothing in any log
# pointing at the mount. This went unnoticed for about three weeks. Defaults from
# SPOTTER_HOME; override only to point at a different tree.
SPOTTER_ENRICHERS_DIR=/absolute/path/to/SPOTTER/flowsint-custom/enrichers

# ── EyeWitness screenshot directory ──────────────────────────────────────────
# Absolute host path, shared read-WRITE by the n8n task runners (WF06 writes web
# screenshots here, under /<sketch_id>/) and read-only by spotter-ui, which serves
# them auth-gated at /screenshots/. Both MUST mount the same directory or the
# dashboard shows broken images for screenshots that were captured successfully.
# Must be writable by uid 1000, the runner uid. Defaults from SPOTTER_HOME.
SPOTTER_SCREENSHOTS_DIR=/absolute/path/to/SPOTTER/screenshots

# ── n8n task-runner config (import allowlist + allowed-env) ───────────────────
# Absolute host path to SPOTTER/deployment/n8n-task-runners.json. Same rule as
# SPOTTER_SCRIPTS_DIR, and the nastiest instance of it. The default now derives
# from SPOTTER_HOME; it used to be a bare "./n8n-task-runners.json", which
# resolves against the PROJECT directory — the Flowsint checkout under the
# multi-file launch, where a stale copy of this file lives. Compose mounts that one, the launcher applies its
# env-overrides, and the Python runner enforces an OLDER import allowlist than
# this repo ships. Nothing errors: a code node just dies at run time with
# ModuleNotFoundError on an allowlisted module, while `docker exec printenv`
# shows the launcher's correct value and hides the disagreement.
SPOTTER_RUNNERS_CONFIG=/absolute/path/to/SPOTTER/deployment/n8n-task-runners.json

# ── Plain-text ingest safety ─────────────────────────────────────────────────
# Plain text that no parser recognizes is extracted by the LLM. Keep 'ingest' to
# preserve default behavior, or set preview/quarantine to parse and return
# review-needed entities without writing them to the graph.
SPOTTER_LLM_TEXT_INGEST_MODE=ingest

# ── SPOTTER cache directory (CVE / MITRE / PoC / RAG index) ──────────────────
# Absolute HOST path, mounted read-write into the n8n task runners and read by
# Open WebUI's Tool code. Same absolute-path rule as SPOTTER_SCRIPTS_DIR above:
# the compose default (../.spotter-cache) resolves against /root/flowsint under
# the documented launch command and is therefore wrong.
#
# What lands here:
#   cve_cache.db          NVD responses, 7-day TTL (scripts/cve_client.py)
#   enterprise-attack.json  MITRE ATT&CK STIX bundle (scripts/mitre_client.py)
#   rag_index/*.json      the RAG collections (scripts/rag_indexer.py)
#   poc-in-github/        PoC-in-GitHub mirror (scripts/sync_poc_mirror.py)
#   poc_fts.sqlite        keyword index over that mirror
#
# This was a Docker named volume until 2026-08-18. It is a bind mount now so the
# runners and Open WebUI share ONE cache, and so the PoC mirror can be synced
# from the host by cron without docker exec.
SPOTTER_CACHE_HOST_DIR=/absolute/path/to/SPOTTER/.spotter-cache
# uid/gid of the Python task runner user; cache setup grants this group write.
SPOTTER_RUNNER_GID=1000

# ── Technology context: CVE (NVD) + MITRE ATT&CK ─────────────────────────────
# Optional NIST NVD API key from https://nvd.nist.gov/developers/request-an-api-key
# STRONGLY recommended: without it the client is rate-limited to one request per
# 6 seconds, so indexing a few hundred technology keywords takes hours instead of
# minutes and WF14 will look like it has hung.
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set NVD_API_KEY)
# NVD_API_KEY=REPLACE_WITH_NVD_API_KEY
# Optional proxy for NVD's target-derived product/version lookups. Leave empty
# for direct egress, or set to the managed SOCKS5 tunnel, e.g.
# socks5h://ssh-tunnel-api:1080. If unset, cve_client reuses BUCKET_PROBE_PROXY
# when that is configured.
# NVD_PROXY_URL=socks5h://ssh-tunnel-api:1080
#
# Optional embedding endpoint for the RAG index. When VLLM_EMBEDDING_MODE=remote,
# it must implement OpenAI-compatible POST /v1/embeddings. Left unset, the RAG
# index uses a deterministic pure-Python TF-IDF vectoriser.
# EMBEDDING_URL=
# EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base

# ── PoC-in-GitHub (exploit availability) ─────────────────────────────────────
# Mirror of https://github.com/nomi-sec/PoC-in-GitHub — a per-CVE index of public
# GitHub repositories claiming to hold proof-of-concept code. Synced from the
# host, never from inside a container:
#
#   python3 scripts/sync_poc_mirror.py --dry-run    # report size before committing disk
#   python3 scripts/sync_poc_mirror.py              # clone or pull, then rebuild the index
#
# Add to root's crontab for a weekly refresh (the upstream repo is append-mostly):
#   17 4 * * 0  cd /root/SPOTTER && python3 scripts/sync_poc_mirror.py >> /var/log/spotter-poc-sync.log 2>&1
#
# IMPORTANT — these repositories are UNVETTED. They are collected by matching a
# CVE ID against repository names and descriptions, so the set includes forks of
# forks, empty stubs, unrelated projects and occasionally malware. SPOTTER ranks
# and labels them; it never downloads or runs their contents, and neither should
# an operator without reading the source first.
#
# Defaults to $SPOTTER_CACHE_HOST_DIR/poc-in-github. Only set this to relocate it.
# POC_MIRROR_DIR=
#
# Runtime-tunable from the Configuration panel (admin only); the values here are
# the deployment defaults. Minimum stars for a repo to be reported at all (0 keeps
# everything and lets the trust tier do the filtering), and the cap per CVE.
POC_MIN_STARS=0
POC_MAX_PER_CVE=10
# Mirror is reported stale past this age, so a months-old clone cannot be mistaken
# for "no public exploits exist".
POC_MIRROR_MAX_AGE_DAYS=30
# Bounds on the WF14 enrichment pass: CVEs resolved per technology, and how many
# Technology/Service nodes one run may enrich.
CVE_MAX_PER_TECH=10
TECH_ENRICH_MAX_NODES=500

# ── Nessus / Tenable vulnerability ingest (workflows 06 + 25) ────────────────
# A Nessus CSV export is ingested from the Ingest tab like any other artifact —
# there is no scanner API to configure, and nothing here is a credential.
#
# One-time setup per install, or every finding is silently dropped:
#   python3 scripts/register_nessus_type.py --apply
# The Vulnerability node type is custom, and Flowsint's serializer 500s GET
# /graph for the WHOLE sketch on a nodeType it cannot resolve. Until it is
# registered, uploads still import the scanned hosts and their technologies and
# return a warning instead.
#
# Caps on one upload. Each REPORTS what it dropped rather than truncating
# silently: a report that says nothing about being cut looks like a clean estate.
# An enterprise scan is genuinely large — 5k hosts x 40 findings is 200k rows.
SPOTTER_NESSUS_MAX_ROWS=300000
SPOTTER_NESSUS_MAX_HOSTS=20000
SPOTTER_NESSUS_MAX_PLUGINS=5000
SPOTTER_NESSUS_MAX_TECH=2000
# Per-host observations embedded on one Vulnerability node (ports, plugin output,
# last seen). They live on the node because Flowsint drops edge properties on
# import, so this is what bounds a node's size when a plugin fires on many hosts.
SPOTTER_NESSUS_MAX_HOST_DETAILS=50
# 0 skips severity-None plugins as findings — roughly two thirds of any report is
# banners and enumeration, and ingesting it buries the findings that matter. Those
# rows are still mined for OS identification and CPE enumeration, and the skipped
# count is always reported. 1 makes each one a graph node too.
SPOTTER_NESSUS_INCLUDE_INFO=0
# Findings contextualized per run of workflow 25 (exploit availability from the
# local PoC mirror, ATT&CK context, recomputed priority, per-host rollup).
NESSUS_CONTEXT_MAX_NODES=1000
# MAX_ROWS, INCLUDE_INFO and NESSUS_CONTEXT_MAX_NODES are also runtime-tunable
# from the Configuration panel (admin only); these are the deployment defaults.

# ── Flare.io ──────────────────────────────────────────────────────────────────
# API key from https://app.flare.io/#/profile → API Keys
# Tokens are auto-generated (1-hour JWT) by the ingestor workflow.
# ASTP must be enabled on your Flare tenant for credential search.
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT put the value here; scripts/spotter_secret.py set FLARE_API_KEY)
FLARE_API_KEY=REPLACE_WITH_FLARE_API_KEY

# ── FOFA.io ─────────────────────────────────────────────────────────────────
# API key from https://en.fofa.info account → Personal Center → API.
# Used by Domain Recon (workflow 13) "Enrich FOFA.io" for host/port/product
# attack-surface inventory. FOFA API v1 auth is key-only (no email needed).
# Docs: https://en.fofa.info/api
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT put the value here; scripts/spotter_secret.py set FOFA_API_KEY)
FOFA_API_KEY=REPLACE_WITH_FOFA_API_KEY

# ── Shodan (optional) ─────────────────────────────────────────────────────────
# Domain Recon uses the free keyless Shodan InternetDB by default. Set a key to
# also query the full Shodan host-search API. Key from https://account.shodan.io
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set SHODAN_API_KEY)
# SHODAN_API_KEY=REPLACE_WITH_SHODAN_API_KEY

# ── Cloud storage exposure (Domain Recon / workflow 13, "Enrich Cloud Buckets") ─
# Finds publicly readable S3 / Azure Blob / GCS storage belonging to the target,
# records the object NAMES it can list, and flags credential/backup/PII-shaped ones.
# Object contents are never downloaded. Two independent sources:
#
#   1. GrayhatWarfare (PASSIVE) — an index of already-public buckets and files.
#      No traffic to the target or to the cloud providers. Free tier available at
#      https://buckets.grayhatwarfare.com — register, then Account → API.
#      This is the more reliable of the two for AWS; see the throttling note below.
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set GRAYHATWARFARE_API_KEY)
# GRAYHATWARFARE_API_KEY=REPLACE_WITH_GRAYHATWARFARE_API_KEY
#
#   2. Active list-check probe — builds candidate bucket names from the target's own
#      identifiers (domain, WHOIS org, LinkedIn name, CT subdomains) and asks
#      AWS/Azure/GCP whether each allows anonymous listing. Requests go to the cloud
#      providers, NEVER to the target's infrastructure. Still, confirm your RoE
#      permits third-party cloud probing before enabling it.
#
# Set to 0 to run passive-only (GrayhatWarfare still works):
BUCKET_PROBE_MAX_CANDIDATES=150
BUCKET_PROBE_CONCURRENCY=8
BUCKET_PROBE_TIMEOUT=6
# Hard wall-clock ceiling for the probe so a slow provider can't hang the webhook.
BUCKET_PROBE_MAX_SECONDS=90
# Minimum exposure score (0-100) for an open bucket to raise an alerts-feed
# notification (WF24). Confirmed-open buckets with no score are surfaced anyway.
BUCKET_ALERT_MIN_SCORE=40
#
# IMPORTANT — AWS throttles anonymous S3 bucket probing per source IP, and once
# tripped EVERY bucket answers "NoSuchBucket", including ones that exist. A blocked
# probe is therefore indistinguishable from a clean sweep. Workflow 13 checks this
# known-public canary bucket before and after each run; if the canary stops
# resolving it SKIPS S3 name-guessing and says so in `errors` rather than reporting
# a meaningless zero. Blocks observed to last well over five minutes, so raising
# the limits above makes coverage worse, not better.
BUCKET_PROBE_S3_CANARY=noaa-goes16
#
# Optional egress proxy for the probe only (not for Flowsint/Neo4j/sidecar traffic).
# Point at the managed SOCKS5 tunnel to spend a different source IP's quota:
#   BUCKET_PROBE_PROXY=socks5h://ssh-tunnel-api:1080
# socks5h:// requires PySocks in the runners image (deployment/Dockerfile.runners).
# BUCKET_PROBE_PROXY=
# Optional base URL override for the passive-DNS provider used by workflow 13.
# Leave at default unless you intentionally mirror ip.thc.org.
THC_IP_BASE_URL=https://ip.thc.org

# ── Social enrichment ownership/orchestration ────────────────────────────────
# direct = workflow 03 calls the maigret/linkedin sidecars itself and writes
#          SocialProfile nodes + HAS_PROFILE edges directly. Works out of the box
#          as long as the sidecars are reachable (no Flowsint flow setup needed).
# plugin = workflow 03 only triggers Flowsint enricher flows; the plugin enrichers
#          own the profile writes. Requires the two SOCIAL_*_FLOW_ID values below
#          to point at real flows AND the enrichers mounted in flowsint-celery.
#          NOTE: in plugin mode with empty/placeholder flow IDs, WF03 is a no-op
#          (returns "misconfigured") and nothing is ever written to the graph.
# ("legacy" is accepted as an alias for "direct" — any non-"plugin" value = direct.)
SOCIAL_ENRICHMENT_OWNER=direct

# Flowsint enricher flow IDs — only used when SOCIAL_ENRICHMENT_OWNER=plugin.
SOCIAL_MAIGRET_FLOW_ID=REPLACE_WITH_MAIGRET_ENRICHER_FLOW_ID
SOCIAL_LINKEDIN_FLOW_ID=REPLACE_WITH_LINKEDIN_ENRICHER_FLOW_ID

# ── Regional social platform coverage (direct mode only) ─────────────────────
# The Objectives tab ships a per-campaign US/RU/CN selection to WF03 as
# `social_regions`. These are Maigret site-DB *tags*, and they are ADDITIVE: each
# selected region is swept in ADDITION to the global top-sites pass, never instead
# of it. That is not a style choice — Maigret tags only 61 sites 'us' and 32 'cn',
# and GitHub/Instagram/Twitter/LinkedIn/Facebook carry no country tag at all, so a
# region *filter* would drop every major platform.
#
# Sites per region at the default budget below: ru ~41 (VK, Odnoklassniki,
# LiveJournal, Habr, Pikabu, Rutracker, xakep.ru), cn ~31 (CSDN, Weibo, Zhihu,
# Douban, Gitee, v2ex), us ~40 (Amazon, Calendly, Venmo, MeetMe).
SOCIAL_MAIGRET_REGION_TOP_SITES=40

# Regions for runs that arrive with NO body and therefore no campaign selection —
# i.e. WF03's Daily Sweep schedule trigger. Empty = global platforms only, which
# is the pre-existing behaviour. Comma-separated, e.g. "ru,cn".
SOCIAL_DEFAULT_REGIONS=

# ── socid-extractor second stage ─────────────────────────────────────────────
# After discovery, WF03 opens each newly found profile URL and mines it for
# identifiers (numeric uid, real name, bio, contact emails, cross-platform links)
# via the /extract endpoint on maigret-api. socid-extractor needs no install of
# its own: Maigret depends on it, so it ships inside that same image.
SOCIAL_SOCID_ENABLED=1
# Profile URLs mined per individual per run. Each is 1-3 HTTP fetches, so this is
# the main cost knob for the second stage.
SOCIAL_SOCID_MAX_URLS=12
# Per-fetch timeout, seconds.
SOCIAL_SOCID_TIMEOUT=15

# ── hh.ru organization intelligence (RU region) ──────────────────────────────
# Live Analysis › Organization. WF13's `org` source builds the corporate profile,
# subsidiary list, department/role structure, offices, recruiter contacts and
# tech stack for the target company. It runs only when the campaign has **RU**
# ticked in Objectives › Target Social Media Enrichment Options — hh.ru covers
# RU/CIS employers, and querying it from an unrelated campaign is egress that
# buys nothing while telling a Russian job board the target interests someone.
#
# The vendor half of the card (SPF / MX / NS / CNAME → third-party providers)
# needs none of this and runs on any domain.
#
# TRANSPORT. Default is `auto`: scrape the public pages, and switch to the
# documented REST API as soon as an application credential is set below.
# Scraping is the default because api.hh.ru's employer and vacancy endpoints are
# NOT anonymous — verified 2026-09-19, /employers, /employers/{id} and
# /vacancies all answer 403 `forbidden` with a correctly formed HH-User-Agent,
# while /areas, /industries and /dictionaries answer 200. The public pages embed
# the whole server-side state as JSON and actually carry MORE than the API does
# (the API's employer record has no department names and no address list).
#   auto | api | scrape
HH_MODE=auto

# Application credential from https://dev.hh.ru/admin. Either pre-mint the token
# there and set HH_APP_TOKEN, or set the id+secret and let SPOTTER exchange them
# for one (grant_type=client_credentials). Regenerating the token revokes the
# previous one. Leave all three empty to stay on the scrape path.
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT put the value here; scripts/spotter_secret.py set HH_APP_TOKEN)
HH_APP_TOKEN=
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT put the value here; scripts/spotter_secret.py set HH_CLIENT_ID)
HH_CLIENT_ID=
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT put the value here; scripts/spotter_secret.py set HH_CLIENT_SECRET)
HH_CLIENT_SECRET=

# MANDATORY for the API path, and hh.ru validates its shape: it must be
# "<application name> (<developer contact email>)", e.g.
#   HH_USER_AGENT=SPOTTER (recon@example.com)
# Anything else — including a browser User-Agent, or an app name with no
# parenthesised address — is rejected with HTTP 400 before the Bearer token is
# even looked at. There is deliberately no default: a made-up contact address
# would be a lie told to a third party, so API mode refuses to start until this
# is set. The scrape path does not use it.
HH_USER_AGENT=

# Budget. Employer and vacancy pages run to 3.2 MB each, so
# HH_MAX_VACANCY_DETAILS is the knob that actually costs — it is one more page
# fetch per vacancy, and it is the only source of recruiter contacts and key
# skills. The other two bound list sizes, not egress. All three are also
# runtime-tunable from the Configuration panel.
HH_TIMEOUT=20
HH_MAX_EMPLOYERS=25
HH_MAX_VACANCIES=100
HH_MAX_VACANCY_DETAILS=15

# ── LinkedIn organization intelligence, via search engines ───────────────────
# Live Analysis › Organization. Fills the corporate profile, the org-unit list
# and a people roster (name, job title, location, named technologies) for any
# region — unlike hh.ru, this is not region-gated.
#
# IT NEVER CONTACTS linkedin.com, for two verified reasons (2026-09-20):
#   * It would not work. The anonymous company page answers HTTP 200 with
#     `<title>LinkedIn Login, Sign in</title>` and zero company fields.
#   * linkedin.com/robots.txt is `User-agent: *` / `Disallow: /`, over a notice
#     that automated access without permission is "strictly prohibited".
# What it reads is a SEARCH ENGINE'S INDEX of those pages, via targeted
# `site:linkedin.com/company` and `site:linkedin.com/in` queries.
#
# TRANSPORT. Measured from this host on the same query: SerpAPI works; Bing
# returns HTTP 200 but IGNORES the `site:` operator and hides links behind its
# ck/a redirector; DuckDuckGo answers an HTTP 202 bot-anomaly page. So the free
# engines are a labelled fallback, not a silent one — without a key the card
# says the transport is unreliable instead of showing an empty roster.
#   auto | serpapi | bing | ddg
SERP_MODE=auto
# From https://serpapi.com. Already used by the linkedin-api sidecar; this adds
# it to the n8n runner, where it was NOT previously visible.
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set SERP_API_KEY)
# SERP_API_KEY=REPLACE_WITH_SERP_API_KEY

# EGRESS: each query carries the target's company name to the SERP provider —
# the same exposure class as the existing Flare and hh.ru calls. A proxy does
# not hide it on the SerpAPI path, because the API key identifies the account.
#
# SerpAPI bills per search and the people sweep multiplies by role keyword, so
# this is a hard count, not advice: 2 company identifiers + 1 org-units +
# 6 role queries + 1 open-roles query = 10, and 12 leaves slack. It was 8 while
# the legs already wanted 9, which silently truncated the people sweep.
# 0 disables the LinkedIn provider entirely.
SERP_MAX_SEARCHES=12
SERP_TIMEOUT=45
# Open roles kept per run, AFTER the employer-name gate has rejected postings
# that belong to other companies. google_jobs aggregates LinkedIn, Indeed and
# Glassdoor, so an ungated list would feed a competitor's vacancies into the
# Job Title Match card. Postings are card data only — never graph nodes.
ORG_JOBS_MAX=60
# Comma-separated. Empty uses the built-in six, chosen for an engagement:
# security / sysadmin-IT / devops-cloud / engineer-developer / HR / leadership.
# Each keyword costs one search.
SERP_ROLE_KEYWORDS=

# ── LinkedIn organization intelligence, via Tavily ───────────────────────────
# The SECOND search provider, and a peer of the SERP one rather than one of its
# transports: it emits its own row on the Organization card, and when both keys
# are present Tavily answers first and SerpAPI fills the gaps.
#
# Unlike the SERP provider there is NO keyless transport, so without a key the
# card reports the provider as "skipped" and names this variable — "not asked",
# never "nothing found".
#
# Tavily is a semantic API, not a Google proxy, so it restricts by DOMAIN
# (include_domains) rather than by the `site:` path operator. That is why its
# budget is smaller than SERP_MAX_SEARCHES despite covering the same ground:
# one company search returns the sub-brand pages AND the profiles, and the
# people sweep reuses them at no extra cost.
#
# EGRESS: each query carries the target's company name to Tavily. A proxy does
# NOT hide this — the API key identifies the account regardless.
# From https://tavily.com
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set TAVILY_API_KEY)
# TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY
# 2 company identifiers + 6 role queries = 8, with slack. 0 disables it.
TAVILY_MAX_SEARCHES=10
# Rows per search. 20 is Tavily's ceiling and costs no more than 1, because
# billing is per SEARCH and not per result.
TAVILY_MAX_RESULTS=15
TAVILY_TIMEOUT=45
# 1 = search_depth 'advanced', which DOUBLES the bill (2 credits per search).
TAVILY_SEARCH_DEPTH_ADVANCED=0
# ONE ceiling across search, extract, crawl and map. They bill to a single
# account, so separate counters would drain the key at twice this rate.
# Enforced on a local projection, because Tavily's own `usage` figure is absent
# unless requested and reads 0 until five extractions have succeeded.
# 0 refuses to spend anything.
TAVILY_MAX_CREDITS=50
# Comma-separated. Empty uses the built-in six. NOT the same list as
# SERP_ROLE_KEYWORDS: those carry Google's boolean `OR`, which Tavily reads as
# the literal word "or" and which therefore dilutes a semantic query.
TAVILY_ROLE_KEYWORDS=
# Only for a self-hosted or enterprise endpoint. Empty uses api.tavily.com.
TAVILY_BASE_URL=

# ── Company-website crawl + RAG ──────────────────────────────────────────────
# The only source that works for a private target with no job-board presence and
# a thin LinkedIn page. Crawls the target's own site — in scope under the
# engagement's RoE — extracts org facts, people and technologies, and indexes
# the text so the Prompt tab can answer questions about the company with a
# citation back to the source page.
#
# ROBOTS.TXT IS DELIBERATELY NOT OBEYED. Its Disallow rules routinely hide the
# directories worth reading, and this is the client's own site under a
# documented RoE. The file is still fetched, for its `Sitemap:` directive.
#
# The safety rail is therefore SCOPE, not robots: every URL must be the
# campaign's registrable domain or a subdomain of it, and anything else is
# refused before it is fetched (and counted, so the operator can see it
# happened). Set SITE_ENABLED=0 for an engagement where crawling is out of
# scope.
SITE_ENABLED=1
# Pages fetched per run, after ranking every discovered URL by how
# organizationally interesting its path looks. Discovery is sitemap-first: path
# guessing was tested against a real site and /about, /team, /leadership and
# /contact all 404'd while the real pages sat under non-standard paths,
# reachable only through the sitemap.
# Which crawler fetches the pages.
#   0  SPOTTER's own: sitemap-first discovery, requests leave from the campaign
#      egress, and nothing outside the target's own domain is ever fetched.
#   1  Tavily /map + /extract: Tavily discovers URLs, SPOTTER still ranks them
#      with its own path scoring and pays to extract only the best ones.
#   2  Tavily /crawl: one call, roughly a third of the credits, Tavily picks.
#
# Two things change on 1 and 2. The requests that reach the CLIENT come from
# Tavily's IP addresses rather than yours, so the client's web logs will not
# show the engagement and the traffic cannot be deconflicted against them
# afterwards. And coverage may be lower: Tavily documents that its crawler will
# not read what Googlebot cannot, with no way to change that, so the
# robots-Disallow'd pages the built-in crawler reads on purpose may simply not
# come back — indistinguishable from pages that do not exist. 0 is the only
# backend that disregards robots.txt, because it is the only one fetching for
# itself. Requires TAVILY_API_KEY; without it the crawl FAILS CLOSED and does
# not quietly fall back to the built-in crawler.
SITE_TAVILY=0
# Links per page level on the Tavily backends. 20 matches the built-in crawler,
# so switching backend does not silently change the shape of the crawl.
SITE_TAVILY_BREADTH=20
# 1 = extract_depth 'advanced': doubles the per-page credit cost, recovers tables.
SITE_TAVILY_ADVANCED=0
SITE_MAX_PAGES=60
SITE_MAX_DEPTH=3
# Politeness and bounds. The delay is per request; the crawl also stops at
# SITE_MAX_SECONDS regardless of how many pages are left.
SITE_DELAY_MS=500
SITE_MAX_BYTES_PER_PAGE=2097152
SITE_MAX_SECONDS=180
SITE_TIMEOUT=20
# Egress preflight: one bounded request to the site root BEFORE the crawl opens
# its budget. A target that silently drops the campaign egress (a Tor exit it
# blackholes, say) otherwise spends all of SITE_MAX_SECONDS timing out one page
# at a time and reports zero pages, which used to be indistinguishable from a
# site with nothing on it. Any HTTP answer passes, a 403 included — being refused
# is `blocked`, which the crawl records properly. Set 0 to skip the preflight.
SITE_PREFLIGHT_TIMEOUT=10
# Chunking for the RAG index. 1500 chars sits far under the embedder's
# 8192-token window so a chunk is never truncated, and is small enough that a
# retrieval hit cites a specific passage. The overlap keeps a fact that straddles
# a boundary findable from either side.
SITE_CHUNK_CHARS=1500
SITE_CHUNK_OVERLAP=200

# ── SEC EDGAR (US filings of record) ─────────────────────────────────────────
# The only source on the Organization card that is a FILING, not inference:
# legal name, CIK, SIC industry, state of incorporation, registered address,
# and Exhibit 21 — the company's own signed list of subsidiaries with their
# jurisdictions. Free, keyless, and fast (a whole profile is ~4 requests).
#
# COVERAGE IS SEC FILERS ONLY. US public companies and certain funds; the
# typical private engagement target appears nowhere in EDGAR. A miss is the
# normal case and the card reports `no_match`, never an error.
#
# NOT region-gated, deliberately. Whether a company files with the SEC is a
# fact about the company, not about which regions were ticked in Objectives.
EDGAR_ENABLED=1

# SEC returns HTTP 403 with no User-Agent, and its published policy asks for an
# application name and a real contact address:
#   EDGAR_USER_AGENT=SPOTTER (recon@example.com)
# Left empty, SPOTTER sends an identifying string with no email rather than
# inventing a contact on your behalf. Requests still succeed, but setting a
# real one is the courteous and policy-conformant thing to do.
EDGAR_USER_AGENT=

# Name-match floor, 0-100. EDGAR's name search is loose: searching
# "Example Harbor Information Security" can return unrelated filers that
# merely share a word with it. Adopting one of those would present
# another company's subsidiaries and registered address as the target's, so
# anything below this score is refused and the card names what it declined.
# Lower it only if you are confident in the Primary Target's legal name.
EDGAR_MIN_SCORE=72

# --- Company identification gate (WF13 "Organization") ----------------------
# Which organisation a provider is allowed to call the target. hh.ru's employer
# search matches description text, and a quoted LinkedIn company search returns
# every page that MENTIONS the target, so an unmatched top result is usually a
# different company in the same field. This is how close a candidate's name must
# be to one of the target's identifiers (Objectives > Primary Target / Additional
# Identifiers) before it is adopted; a candidate serving one of the target's own
# domains is accepted regardless. 0 restores the old adopt-the-top-row behaviour.
# Also tunable at runtime from the Configuration panel.
ORG_COMPANY_MATCH_MIN=72

# --- Employment evidence gate (WF13 "People & Positions") -------------------
# A quoted company-name search on LinkedIn returns candidates, not employees:
# former staff, vendors, recruiters, and anyone who merely mentions the company.
# These decide how much evidence a candidate needs before they are counted and
# written to the graph. All four are also tunable at runtime from the
# Configuration panel; the values here are only the deploy-time defaults.
# How close a profile's stated employer must be to the target's name (0-100).
ORG_PEOPLE_EMPLOYER_MIN=72
# Evidence floor to be shown and written. 0 disables the gate entirely.
ORG_PEOPLE_MIN_SCORE=25
# 1 = a location in a different country from the target counts against a row.
ORG_PEOPLE_GEO_GATE=1
# Ceiling on people written to the graph per run, best-evidenced first.
ORG_PEOPLE_MAX_WRITES=120

EDGAR_TIMEOUT=20
EDGAR_MAX_REQUESTS=12

# ── Flowsint flow IDs (per-install, NOT portable) ─────────────────────────────
# These are UUIDs of Flowsint enricher flows created inside YOUR Flowsint instance.
# They are unique to each Flowsint deployment — when standing up a fresh host you
# must recreate the flows in the new Flowsint UI and paste the new UUIDs here.
# SPOTTER_FLOW_ID          — main SPOTTER enrichment flow launched after ingest (WF06).
# SPOTTER_CRED_ENRICHER_FLOW_ID — credential enricher flow triggered by WF11.
SPOTTER_FLOW_ID=REPLACE_WITH_SPOTTER_ENRICHER_FLOW_ID
SPOTTER_CRED_ENRICHER_FLOW_ID=REPLACE_WITH_CRED_ENRICHER_FLOW_ID

# (optional) Flare tenant ID — only needed for multi-tenant accounts
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set FLARE_TENANT_ID)
# FLARE_TENANT_ID=

# ── Infrastructure / managed SSH tunnel ─────────────────────────────────────
# Host path mounted read-only into ssh-tunnel-api at /ssh-keys.
# How the managed tunnel treats the remote host key: accept-new (default,
# trusts an unseen host but refuses a CHANGED key), no (also proceeds through
# a change -- use when the far end is a redirector that gets rebuilt), or yes
# (requires a pre-seeded entry). The sidecar's known_hosts is destroyed on
# every container recreate, so 'yes' needs a mounted store to be usable.
TUNNEL_HOST_KEY_POLICY=accept-new
# Read-only key root. Defaults to the invoking user's ~/.ssh, which exposes that
# WHOLE directory (authorized_keys included) to the sidecar. Point it at a
# directory holding only the engagement key if you would rather not -- or leave
# it and use SPOTTER_TUNNEL_KEYS_DIR below, which is the one the UI writes to.
SSH_KEY_DIR=${HOME}/.ssh

# Writable key root: where the Infrastructure tab puts a key uploaded through
# the browser, mounted at /ssh-keys-uploaded. Kept separate from SSH_KEY_DIR on
# purpose -- mounting the operator's real ~/.ssh read-write would hand the web
# UI the ability to rewrite their authorized_keys. Repo-local, so the stack
# stays one copyable directory; gitignored as /tunnel-keys/.
SPOTTER_TUNNEL_KEYS_DIR=${SPOTTER_HOME}/tunnel-keys

# Both roots the sidecar will READ a key from, in order. Only the upload root
# below is ever written.
# TUNNEL_KEY_ROOTS=/ssh-keys-uploaded,/ssh-keys
# The single root the upload endpoint writes to. It MUST be one of the roots
# above, or an uploaded key would be refused by /tunnel/start immediately after
# it was accepted.
# TUNNEL_UPLOAD_KEY_ROOT=/ssh-keys-uploaded
# Ceiling on an uploaded key, in bytes. An ed25519 key is ~400 B and an RSA-4096
# ~3.2 KB, so the default is generous; nginx caps the request body at 256k
# independently.
# TUNNEL_MAX_KEY_BYTES=65536
# Key used when the Infrastructure tab's key path field is left blank. Empty by
# default on purpose: it used to name /ssh-keys/id_ed25519, a conventional
# filename a given deployment need not have, so a blank field failed against a
# path nobody chose. Left empty, the sidecar uses the only key present, or
# refuses and names the ones that are.
# TUNNEL_DEFAULT_KEY_PATH=
# Ceiling on a passphrase or SSH password. Separate from the key ceiling because
# a 4 KB passphrase is a mistake, while a 4 KB key is routine.
# TUNNEL_MAX_SECRET_LENGTH=4096

# Shared secret for the managed SSH tunnel control endpoints. STRONGLY RECOMMENDED:
# if left empty the ssh-tunnel-api skips auth entirely, so anyone who can reach
# /infra/tunnel/ can start/stop tunnels using the mounted host SSH keys. Generate
# with `openssl rand -hex 32`. When set, the UI sends it in X-Tunnel-Token.
# NOTE: the same token now also gates the Tor control endpoints and the egress
# check — everything under /infra/tunnel/.
#   ^^ CREDENTIAL -> secrets/machine.sops.env  (do NOT put the value here; scripts/spotter_secret.py set TUNNEL_API_TOKEN)
TUNNEL_API_TOKEN=REPLACE_WITH_STRONG_TUNNEL_TOKEN

# ── Infrastructure / managed Tor client ─────────────────────────────────────
# SOCKS port the managed Tor client listens on INSIDE the compose network. Never
# published to the host; workflows reach it as socks5h://ssh-tunnel-api:9050.
# TOR_SOCKS_PORT=9050
#
# Ceiling on how many countries may be selected for entry or exit. Tor treats a
# long node list as a weaker constraint, and it is also the injection surface for
# the generated torrc, so it is bounded.
# TOR_MAX_COUNTRIES=24
#
# Seconds to wait for Tor's SOCKS listener before giving up on start. This is NOT
# the bootstrap wait: start returns as soon as the port answers and the UI polls
# for the bootstrap percentage, because a first circuit can take longer than the
# 30s nginx allows on /infra/tunnel/.
# TOR_STARTUP_TIMEOUT=20

# ── Infrastructure / egress identity check ──────────────────────────────────
# Sources for the "what will the target see" strip at the top of the
# Infrastructure tab, tried in order; the first that returns a parseable PUBLIC
# address wins. None of these JSON shapes is a published contract, so the parser
# accepts JSON, bare text or an HTML page — override this list if one changes.
# The first three return the address AND its location in a single response, so
# the normal check is one call and the country is filled in without a second
# hop. ip.me is last and IP-only: its JSON paths stopped existing (2026-09-20),
# which is why the strip used to read "geo unavailable from https://ip.me/".
# Keep at least two independent vendors here — a single source going down is
# then a slower answer rather than a blank one.
# EGRESS_IP_URLS=https://ifconfig.co/json,https://ipwho.is/,https://api.ipapi.is/,https://ip.me/
#
# Second hop, used ONLY when the source that answered gave an IP but no
# location — not an extra call on the normal path. {ip} is substituted. It goes
# through the SAME proxy as the first hop, so it cannot deanonymise a Tor-routed
# check. Set it EMPTY to refuse the hop outright and accept "geo unavailable".
# EGRESS_GEO_URL=https://ipwho.is/{ip}
#
# Per-request timeout, and a hard ceiling on the whole check across every URL and
# retry. The budget must stay under nginx's 30s proxy_read_timeout for
# /infra/tunnel/, or a dead proxy returns an opaque 504 instead of the error list.
# EGRESS_TIMEOUT=12
# EGRESS_TOTAL_BUDGET=22

# ── Analysis LLM compatibility variables ─────────────────────────────────────
# Model ID served by vLLM for workflows 10/12 and upload extraction. Keep these
# equal to VLLM_MODEL above -- they used to name Qwen/Qwen3-32B, which this host
# does not serve.
SECURITY_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
EXTRACTION_LLM_MODEL=Qwen/Qwen3.8-27B-FP8

# Which backend scripts/llm_client.py and the upload text extractor talk to.
# "vllm" posts OpenAI-style to VLLM_URL; anything else takes the legacy
# Ollama-shaped path, which now reaches llm-gateway rather than Ollama (removed
# 2026-09-04). Absent from this file until 2026-09-06, so a new host silently
# came up on the legacy branch.
SPOTTER_LLM_BACKEND=vllm

# ── LinkedIn OSINT ────────────────────────────────────────────────────────────
# Optional SerpAPI key for more reliable Google-based LinkedIn profile search.
# Without this, the sidecar falls back to DuckDuckGo (no key required).
# Get a key at https://serpapi.com
#   ^^ CREDENTIAL -> secrets/vendors.sops.env  (do NOT uncomment and fill in; scripts/spotter_secret.py set SERP_API_KEY)
# SERP_API_KEY=REPLACE_WITH_SERP_API_KEY

# Minimum confidence score (0.0–1.0) to accept a LinkedIn profile match.
# 0.40 = name match alone; 0.65+ = name + company confirmed.
LINKEDIN_CONFIDENCE_THRESHOLD=0.40

# ── Scoring thresholds ────────────────────────────────────────────────────────
# Minimum attack-path score at which an individual is marked high-value (workflow 04)
HIGH_VALUE_SCORE_THRESHOLD=15

# ── Runtime-tunable limits ───────────────────────────────────────────────────
# These are ALSO editable live from the SPOTTER Configuration panel (admin only),
# which stores overrides in (:SpotterMeta {key:'settings'}). Resolution order is
#   panel override  >  the value here  >  the code-node built-in
# so a value set here is the deployment default and applies until someone
# overrides it in the UI. Changing it here needs a container recreate; changing
# it in the panel takes effect on the next workflow run.
#
# Attack path search bounds (workflow 04). Cost grows sharply with hop count.
MAX_ATTACK_HOPS=4
MAX_ATTACK_PATHS_PER_IND=1500
MAX_ATTACK_DOSSIER_WRITES=400
# Cap the public-exploit bonus added to WF04/chat attack-path scores. Default 8
# equals the Domain Admins bonus; set 0 to disable exploit availability in path
# ranking when CVE data is mostly product-name guesses.
EXPLOIT_PATH_MAX_BONUS=8
# Cap the cloud-exposure bonus WF04 assigns to a publicly readable bucket.
# Scored at the ASSET, not the person: MANAGES is excluded from path scoring,
# so a bucket has no route to an Individual and this never moves an
# attack_score on its own. Default 8 equals the Domain Admins bonus; 0
# removes cloud exposure from the ranking.
CLOUD_EXPOSURE_MAX_BONUS=8
# Most a bucket may add to the attack_score of the person WF13 attributed it
# to, via the asset-scoped MANAGES_NAMED edge only. DEFAULT 0 (off):
# crediting an owner reverses the standing "ownership is not hosting"
# decision, so it is an explicit operator choice. Plain MANAGES -- the domain
# registrant, which WF13 attaches to every asset in a sweep including CDN
# endpoints -- is never scored at any setting.
CLOUD_OWNER_MAX_BONUS=0
# Largest single file handed to Titus for credential scanning (workflow 11).
SPOTTER_CRED_SCAN_MAX_BYTES=10485760

# Passive DNS / reverse-DNS limits for ip.thc.org in workflow 13.
THC_SUBDOMAIN_LIMIT=300
THC_RDNS_MAX_IPS=8
THC_TIMEOUT=15

# Flare.io domain breach export caps for workflow 13.
FLARE_DOMAIN_MAX_CREDS=50000
FLARE_DOMAIN_PAGE_SIZE=1000
FLARE_DOMAIN_LIST_CAP=1000
# How many breach-to-graph credential-match rows the response carries. Sorted
# admins-first, so the cap keeps the useful ones, and credential_matches_total
# always reports the true count. Uncapped before 2026-09-08, when a large domain's
# match list pushed one cached recon record past the browser's ~5MB budget.
FLARE_DOMAIN_MATCH_CAP=500
FLARE_DOMAIN_PROMOTE=1
# Cap on how many individuals ONE untargeted Flare sweep searches (workflow 09's
# Daily Sweep). One Flare credential search is issued per individual, so without
# this a scheduled run's outbound volume is a function of AD size -- a large
# AD can hold tens of thousands of individuals. Never-searched people go first,
# then least-recently-searched, so consecutive days walk the whole population.
# Targeted runs (the dossier's repair button) ignore this. 0 disables the cap.
FLARE_MAX_PER_RUN=250

# Super-Enrich identity pivot caps for workflow 27.
SUPERENRICH_MAX_USERNAMES=5
SUPERENRICH_MAX_SOCID_URLS=12
SUPERENRICH_MAX_ALT_EMAILS=25
SUPERENRICH_MAX_EVENTS=15
SUPERENRICH_MAIGRET_TOP_SITES=40
SUPERENRICH_MAIGRET_TIMEOUT=8

# Notification ticker sweep/retention controls for workflow 24.
NOTIFY_SWEEP_INTERVAL=120
NOTIFY_MAX_PER_SWEEP=25
NOTIFY_RETENTION=500
NOTIFY_ACTIVE_MINUTES=30

# ── Brute Ratel receiver (workflow 21) ───────────────────────────────────────
# Optional shared secret for the Brute Ratel listener ingress. A listener can
# present neither the session cookie that gates every other port nor a custom
# header, so its ingress is its own nginx server block on 8099 -- the one
# block without auth_request -- which maps ANY path to /webhook/brute-ratel.
# Caddy re-terminates TLS for it in front, pinned to the literal loopback IP
# (BRc4's webhook dialog takes only a bare scheme://host:port, no hostname).
#
#   Commander webhook URL:  https://127.0.0.1:5443
#   Reached from the Ratel server by:  ssh -N -L 5443:127.0.0.1:5443 <spotter-host>
#
# LEFT EMPTY BY DEFAULT, and empty means the check is SKIPPED, not that requests
# are refused: nothing then authenticates a POST that reaches 5443, and the
# security boundary is that the port binds 127.0.0.1 and is reachable only
# through the operator-held SSH tunnel above.
#
# The argument against setting one: BRc4's webhook dialog has a single URL field,
# so a secret can only ride the query string, and whether Commander preserves it
# is undocumented -- the manual's page is a screenshot showing a bare
# scheme://host:port. A token Commander silently strips rejects EVERY badger and
# fails identically to a broken tunnel. If you do set one, append ?t=<secret> to
# the URL in every listener's webhook, recreate task-runners, then check the
# access log reads token=present on a real check-in (it never logs the value).
#
# Do NOT point Commander at :5678 -- n8n publishes no host port on purpose -- or
# at the dashboard hostname, where a cookie-less POST from a listener is
# answered with 401. Any hostname OTHER than the bare IP on :5443 is the
# dashboard/n8n/graph vhosts, not this ingress.
#
# Left present-but-empty rather than commented out, so the knob is visible in a
# seeded .env. Empty = check skipped, per the paragraphs above.
#   ^^ CREDENTIAL -> secrets/engagement.sops.env  (do NOT put the value here; scripts/spotter_secret.py set BRC4_WEBHOOK_TOKEN)
BRC4_WEBHOOK_TOKEN=

# ── SPOTTER authentication (web UI login + per-user campaigns) ───────────────
# Accounts are admin-provisioned:  scripts/spotter_user.py add <username>
# Max campaigns each operator may OWN. Shared-in campaigns do not count.
# Changing this requires the same value in three places -- here, the
# task-runners `environment:` block in deployment/docker-compose.n8n.yml, and
# the python runner's `allowed-env` in n8n-task-runners.json -- or the code node
# silently falls back to the built-in default of 3.
SPOTTER_MAX_CAMPAIGNS_PER_USER=3
# Session lifetime: idle timeout, and a hard cap regardless of activity.
SPOTTER_SESSION_IDLE_HOURS=12
SPOTTER_SESSION_MAX_DAYS=7
# Failed logins before the account locks, and for how long.
SPOTTER_LOGIN_MAX_FAILS=10
SPOTTER_LOGIN_LOCK_MINUTES=15
# Set true ONLY when SPOTTER is served over https -- a Secure cookie is never
# sent back over plain http, which makes login appear to silently loop. Now
# the default, since the Caddy TLS front door (:5443) is on by default; set
# back to false only if you have removed docker-compose.caddy.yml from the
# stack and are back to plain-http loopback access.
SPOTTER_COOKIE_SECURE=true
# Shared parent domain of the Caddy vhosts (SPOTTER_DASHBOARD_HOST/N8N_HOST/
# GRAPH_HOST above) so logging in at the dashboard also authenticates the n8n
# and graph vhosts. Those are three different HOSTNAMES now, not sibling
# ports on one host, and a cookie with no Domain attribute is host-only --
# without this, only the vhost you actually logged in on would see the
# session. Must be a domain the three vhosts are subdomains of (or equal to);
# leave empty for a host-only cookie if you have replaced Caddy's default
# hostnames with something unrelated.
SPOTTER_COOKIE_DOMAIN=spotter.localhost
